# Backend environment variables — copy to .env and fill in
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notflix?retryWrites=true&w=majority
REDIS_URL=redis://default:<password>@<host>.db.redis.io:<port>
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com
JWT_SECRET=<random-64-char-hex>
SESSION_SECRET=<random-64-char-hex>
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
OCR_SPACE_API_KEY=<your-ocr-api-key>
CONTACT_EMAIL_USER=your-email@gmail.com
CONTACT_EMAIL_PASS=your-app-password
CONTACT_EMAIL_TO=your-email@gmail.com
CONTACT_EMAIL_FROM=your-email@gmail.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx